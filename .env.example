NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173,http://192.168.1.109:5173
SUPABASE_DB_URL=
APP_TIME_ZONE=Asia/Kolkata
JWT_SECRET=
JWT_REFRESH_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=60000
COOKIE_SECURE=false
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=development-only-change-this-password

# Email Service Option A: EmailJS (Sends to ANY email via your personal Gmail account - Free 200/mo)
# Works on Render Free Tier over HTTPS Port 443 with zero port blocks
# Get keys at https://www.emailjs.com
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Email Service Option B: Resend API (Free 3,000/mo)
# Note: On free tier with onboarding@resend.dev, Resend only sends to your own registered email address
# unless you add and verify a custom domain.
RESEND_API_KEY=
RESEND_FROM=Carekind <onboarding@resend.dev>

# Email Service Option C: Gmail SMTP (For local development or paid servers with open SMTP ports)
# Note: Render Free Tier blocks outbound SMTP ports 25, 465, and 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Carekind <your-email@gmail.com>

